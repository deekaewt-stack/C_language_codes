#include <stdio.h>
int main(){
    int year = 0;
    printf("Input year\n");
    scanf("%d",&year);
    if (year%4==0){
        if(year%100==0){
            if(year%400==0){
            printf("It's a leap year");
            return 1;
            }
            printf("It's a common year");
            return 1;
        }
        printf("It's a leap year");
    }
    else{
        printf("It's a normal year");
    }
    
    return 0;
}
